{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the app's static files and the API. Requests under /api/
  // reach the Worker first; everything else is a static file, and an unknown
  // path gets index.html so client-side routes work.
  "name": "genomecanvas",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
}
