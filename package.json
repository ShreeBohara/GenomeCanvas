{
  "name": "genomecanvas",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build:fixtures": "python3 backend/scripts/build_fixtures.py",
    "dev:backend": "cd backend && python3 -m uvicorn app.main:app --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "lint:frontend": "npm --prefix frontend run lint",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "python3 -m unittest discover -s backend/tests",
    "test:frontend": "npm --prefix frontend run test",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
